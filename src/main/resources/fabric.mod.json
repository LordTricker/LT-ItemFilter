{
	"schemaVersion": 1,
	"id": "ltifilter",
	"version": "${version}",
	"name": "LT-ItemFilter",
	"description": "Amatorska modyfikacja pozwalająca na szybkie czyszczenie przedmiotów w ewkipunku, a także podświetlanie ich na mapie. Jeżeli powielasz, to miłoby było jakbyś podzielił się info na kim bazujesz <3.",
	"authors": [
		"LordTricker"
	],
	"contact": {
		"homepage": "https://blazecode.pl/",
		"sources": "https://github.com/LordTricker"
	},
	"license": "MIT",
	"icon": "assets/ltifilter/icon.png",

	"environment": "*",
	"entrypoints": {
		"client": [
			"pl.lordtricker.ltifilter.client.LtifilterClient"
		]
	},
	"mixins": [
		{
			"config": "ltifilter.client.mixins.json",
			"environment": "client"
		}
	],

	"depends": {
		"fabricloader": ">=0.12.0",
		"minecraft": "~1.18.2",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}
